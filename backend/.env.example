# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/codes-minds

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin (used by the seed script to create the first admin account)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@codesminds.com
ADMIN_PASSWORD=change_this_password

# Email (contact form notifications) - example uses Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=admin@codesminds.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
