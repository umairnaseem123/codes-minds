{
  "version": 2,
  "buildCommand": "cd codes-minds && npm install && npm run build",
  "outputDirectory": "codes-minds/dist",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
